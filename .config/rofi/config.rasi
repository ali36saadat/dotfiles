configuration {
    modi: "drun,run,window";
    show-icons: false;
}

@import "/home/ali/.local/share/themes/current/current.rasi"

* {
    font: "Roboto 12";

    background-color: transparent;
    text-color: @accent;

    margin: 0px;
    padding: 0px;
    spacing: 0px;

    selected-normal-foreground:     @text;
    foreground:                     @text;
    normal-foreground:              @text;
    alternate-normal-background:   @surface;
    red:                            @accent;
    selected-urgent-foreground:    @text;
    blue:                           @accent;
    urgent-foreground:              @secondary;
    alternate-urgent-background:   @surface;
    active-foreground:             @accent;
    lightbg:                        @surface;
    selected-active-foreground:    @accent;
    alternate-active-background:   @surface;
    background:                     @surface;
    bordercolor:                   @surface;
    alternate-normal-foreground:   @text;
    lightfg:                       @text;
    selected-normal-background:    @surface;
    border-color:                  @surface;
    spacing:                        2;
    separatorcolor:                @surface;
    urgent-background:             @surface;
    selected-urgent-background:    @surface;
    alternate-urgent-foreground:   @secondary;
    background-color:              transparent;
    alternate-active-foreground:   @accent;
    active-background:             @surface;
    selected-active-background:    @surface;

    normal-background:           @surface;
    alternate-normal-background: @surface;
}

window {
    location: north;
    y-offset: calc(50% - 176px);
    width: 560;
    border-radius: 24px;
    background-color: @surface;
}

mainbox {
    padding: 12px;
}

inputbar {
    background-color: @sunken;
    border-radius: 24px;
    padding: 8px 16px;
    spacing: 8px;
    text-color: @text;
    children: [ prompt, entry ];
}

prompt {
    text-color: @secondary;
    text-transform: uppercase;
    font: "Roboto Medium 12";
}

entry {
    placeholder: "Search";
    placeholder-color: @secondary;
}

listview {
    background-color: transparent;
    margin: 12px 0 0;
    lines: 8;
    columns: 1;
    fixed-height: true;
}

element {
    padding: 8px 16px;
    spacing: 8px;
    border-radius: 16px;
    background-color: red;
}


element selected normal,
element selected active {
    background-color: @secondary;
    text-color: @sunken;
    border-radius: 24px;
}

listview {
    scrollbar: false;
}